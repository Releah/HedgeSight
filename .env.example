POSTGRES_DB=hedgesight
POSTGRES_USER=hedgesight
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://hedgesight:change-me@postgres:5432/hedgesight
APP_PORT=8080
WORKER_NAME=local-worker
WORKER_TOKEN=local-development-token
HEDGESIGHT_API_URL=http://app:8080
JOB_POLL_INTERVAL_MS=3000
JOB_LEASE_SECONDS=45
HEDGESIGHT_VERSION=0.1.0-dev
CONFIG_ENCRYPTION_KEY=replace-with-a-long-random-secret
SESSION_DAYS=7
INCIDENT_CORRELATION_SECONDS=300
COOKIE_SECURE=false
TRUST_PROXY=false
# Optional OpenID Connect login. Register this exact callback with your provider.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8080/api/auth/oidc/callback
